<Window x:Class="CodeTypingTrainer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Тренажёр слепой печати кода"
        Height="700" Width="1100"
        MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E2E">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <!-- Шапка -->
            <RowDefinition Height="*"/>
            <!-- Основная зона -->
            <RowDefinition Height="50"/>
            <!-- Статусная строка -->
        </Grid.RowDefinitions>

        <!-- ШАПКА -->
        <Border Grid.Row="0" Background="#181825" Padding="20,0">
            <Grid>
                <TextBlock Text="⌨ CodeTypingTrainer"
                           Foreground="#CDD6F4"
                           FontSize="20" FontWeight="Bold"
                           VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                    <Button Content="🔊 Тест TTS"
                            Width="100" Height="32"
                            Margin="5,0" Click="TestTts_Click"/>
                    <Button Content="🌙 Тема"
                            Width="90" Height="32"
                            Margin="5,0" Click="ThemeButton_Click"/>
                    <Button Content="👤 Профиль"
                            Width="90" Height="32"
                            Margin="5,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ОСНОВНАЯ ЗОНА -->
        <Grid Grid.Row="1" Margin="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200"/>
                <!-- Боковая панель -->
                <ColumnDefinition Width="*"/>
                <!-- Рабочая зона -->
            </Grid.ColumnDefinitions>

            <!-- БОКОВАЯ ПАНЕЛЬ -->
            <Border Grid.Column="0" Background="#181825"
                    CornerRadius="8" Margin="0,0,10,0" Padding="10">
                <StackPanel>
                    <TextBlock Text="РЕЖИМ" Foreground="#6C7086"
                               FontSize="11" Margin="5,5,5,10"/>
                    <Button Content="▶ Обычный режим"
                            Height="36" Margin="0,3"
                            Tag="Normal" Click="ModeButton_Click"/>
                    <Button Content="🧠 По памяти"
                            Height="36" Margin="0,3"
                            Tag="Memory" Click="ModeButton_Click"/>
                    <Button Content="🔊 На слух"
                            Height="36" Margin="0,3"
                            Tag="Audio" Click="ModeButton_Click"/>

                    <TextBlock Text="ЯЗЫК" Foreground="#6C7086"
                               FontSize="11" Margin="5,15,5,10"/>
                    <ComboBox x:Name="LanguageCombo" Height="32"
                              SelectionChanged="LanguageCombo_SelectionChanged">
                        <ComboBoxItem Content="Python" IsSelected="True"/>
                        <ComboBoxItem Content="JavaScript"/>
                        <ComboBoxItem Content="C++"/>
                        <ComboBoxItem Content="Java"/>
                        <ComboBoxItem Content="Go"/>
                    </ComboBox>
                    <!-- Управление озвучкой — видно только в режиме "На слух" -->
                    <StackPanel x:Name="AudioControlsPanel" Visibility="Collapsed">
                        <TextBlock Text="ОЗВУЧКА" Foreground="#6C7086"
               FontSize="11" Margin="5,15,5,10"/>

                        <Button x:Name="ReplayLineButton" Content="🔁 Повторить строку"
            Height="32" Margin="0,3" Click="ReplayLineButton_Click"/>

                        <Button x:Name="NextLineButton" Content="⏭ Следующая строка"
            Height="32" Margin="0,3" Click="NextLineButton_Click"/>

                        <TextBlock Text="Скорость" Foreground="#6C7086"
               FontSize="11" Margin="5,10,5,2"/>
                        <Slider x:Name="SpeedSlider"
            Minimum="0.5" Maximum="2" Value="1"
            TickFrequency="0.25" IsSnapToTickEnabled="True"
            ValueChanged="SpeedSlider_ValueChanged"/>

                        <Button x:Name="ShowCodeButton" Content="👁 Показать код"
            Height="32" Margin="0,10,0,3"
            IsEnabled="False" Click="ShowCodeButton_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- РАБОЧАЯ ЗОНА -->
            <Border Grid.Column="1" Background="#181825"
                    CornerRadius="8" Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="40"/>
                        <!-- Статистика сессии -->
                        <RowDefinition Height="*"/>
                        <!-- Код для набора -->
                        <RowDefinition Height="80"/>
                        <!-- Поле ввода -->
                        <RowDefinition Height="50"/>
                        <!-- Кнопки управления -->
                    </Grid.RowDefinitions>

                    <!-- Статистика сессии -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal">
                        <Border Background="#313244" CornerRadius="4" Padding="10,5" Margin="0,0,10,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="WPM: " Foreground="#6C7086"/>
                                <TextBlock x:Name="WpmText" Text="0"
                                           Foreground="#A6E3A1" FontWeight="Bold"/>
                            </StackPanel>
                        </Border>
                        <Border Background="#313244" CornerRadius="4" Padding="10,5" Margin="0,0,10,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Точность: " Foreground="#6C7086"/>
                                <TextBlock x:Name="AccuracyText" Text="100%"
                                           Foreground="#89B4FA" FontWeight="Bold"/>
                            </StackPanel>
                        </Border>
                        <Border Background="#313244" CornerRadius="4" Padding="10,5">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Время: " Foreground="#6C7086"/>
                                <TextBlock x:Name="TimerText" Text="0:00"
                                           Foreground="#F9E2AF" FontWeight="Bold"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Зона отображения кода -->
                    <Border Grid.Row="1" Background="#1E1E2E"
                            CornerRadius="6" Margin="0,10" Padding="15">
                        <ScrollViewer x:Name="CodeScroller"
                                VerticalScrollBarVisibility="Auto">
                            <TextBlock x:Name="CodeDisplay"
                                    FontFamily="Cascadia Code, Consolas, Courier New"
                                    FontSize="16" TextWrapping="Wrap"
                                    xml:space="preserve"
                                    Text="Нажмите «Старт» для начала тренировки"/>   
                        </ScrollViewer>
                    </Border>

                    <!-- Поле ввода + всплывающие подсказки -->
                    <Grid Grid.Row="2">
                        <Border Background="#313244" CornerRadius="6" Padding="10">
                            <TextBox x:Name="InputBox"
                                 FontFamily="Cascadia Code, Consolas, Courier New"
                                 FontSize="15" Background="Transparent"
                                 Foreground="#CDD6F4" BorderThickness="0"
                                 AcceptsReturn="True" AcceptsTab="True"
                                 IsEnabled="False"
                                 TextChanged="InputBox_TextChanged"
                                 PreviewKeyDown="InputBox_PreviewKeyDown"/>
                        </Border>

                        <!-- Всплывающий список подсказок -->
                        <Popup x:Name="SuggestionsPopup"
                                PlacementTarget="{x:Reference InputBox}"
                                Placement="Bottom"
                                StaysOpen="False">
                            <Border Background="#313244" BorderBrush="#585B70"
                                    BorderThickness="1" CornerRadius="4">
                                <ListBox x:Name="SuggestionsList"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         Foreground="#CDD6F4"
                                         FontFamily="Cascadia Code, Consolas"
                                         FontSize="14"
                                         MaxHeight="150"
                                         MouseDoubleClick="SuggestionsList_MouseDoubleClick"
                                         KeyDown="SuggestionsList_KeyDown">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="Padding" Value="8,4"/>
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#45475A"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter Property="Background" Value="#89B4FA"/>
                                                    <Setter Property="Foreground" Value="#1E1E2E"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                </ListBox>
                            </Border>
                        </Popup>
                    </Grid>

                    <!-- Кнопки управления -->
                    <StackPanel Grid.Row="3" Orientation="Horizontal"
                                HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Button x:Name="StartButton" Content="▶ Старт"
                                Width="100" Height="36" Margin="5,0"
                                Click="StartButton_Click"/>
                        <Button x:Name="PauseButton" Content="⏸ Пауза"
                                Width="100" Height="36" Margin="5,0"
                                IsEnabled="False" Click="PauseButton_Click"/>
                        <Button x:Name="RestartButton" Content="↺ Заново"
                                Width="100" Height="36" Margin="5,0"
                                IsEnabled="False" Click="RestartButton_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- СТАТУСНАЯ СТРОКА -->
        <Border Grid.Row="2" Background="#181825" Padding="20,0">
            <TextBlock x:Name="StatusText"
                       Text="Готов к работе. Выберите язык и режим, затем нажмите Старт."
                       Foreground="#6C7086" VerticalAlignment="Center"/>
        </Border>
    </Grid>
</Window>