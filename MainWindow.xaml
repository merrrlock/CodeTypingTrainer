<Window x:Class="CodeTypingTrainer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CodeTypingTrainer"
        Height="750" Width="1100"
        MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E2E">

    <Window.Resources>
        <!-- Вкладка -->
        <Style x:Key="TabButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#6C7086"/>
            <Setter Property="BorderThickness" Value="0,0,0,2"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Height" Value="45"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="#CDD6F4"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Иконочная кнопка -->
        <Style x:Key="IconButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#6C7086"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="4" Padding="4">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#313244"/>
                    <Setter Property="Foreground" Value="#CDD6F4"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Основная кнопка действия -->
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#313244"/>
            <Setter Property="Foreground" Value="#CDD6F4"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#45475A"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="#45475A"/>
                    <Setter Property="Background" Value="#1E1E2E"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Кнопка режима в боковой панели -->
        <Style x:Key="ModeButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#1E1E2E"/>
            <Setter Property="Foreground" Value="#CDD6F4"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Left"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#313244"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Кнопка фильтра статистики -->
        <Style x:Key="FilterButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#313244"/>
            <Setter Property="Foreground" Value="#6C7086"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#45475A"/>
                    <Setter Property="Foreground" Value="#CDD6F4"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Стиль выпадающего списка -->
        <Style x:Key="StyledComboBox" TargetType="ComboBox">
            <Setter Property="Background" Value="#313244"/>
            <Setter Property="Foreground" Value="#CDD6F4"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                  IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                  ClickMode="Press" Focusable="False">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="#313244" CornerRadius="6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="28"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="1" Text="▾"
                                                   Foreground="#6C7086" FontSize="11"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <ContentPresenter x:Name="ContentSite"
                                      IsHitTestVisible="False"
                                      Content="{TemplateBinding SelectionBoxItem}"
                                      Margin="{TemplateBinding Padding}"
                                      HorizontalAlignment="Left"
                                      VerticalAlignment="Center"/>

                            <Popup x:Name="Popup" Placement="Bottom"
                           IsOpen="{TemplateBinding IsDropDownOpen}"
                           AllowsTransparency="True" Focusable="False"
                           PopupAnimation="Slide">
                                <Border Background="#313244" CornerRadius="6"
                                BorderBrush="#45475A" BorderThickness="1"
                                MinWidth="{TemplateBinding ActualWidth}"
                                Margin="0,2,0,0">
                                    <ScrollViewer Margin="2" SnapsToDevicePixels="True">
                                        <StackPanel IsItemsHost="True"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#3A3B52"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Элементы выпадающего списка -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#CDD6F4"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border Background="{TemplateBinding Background}"
                        CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#45475A"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#89B4FA"/>
                    <Setter Property="Foreground" Value="#1E1E2E"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="45"/>
            <!-- Шапка-таббар -->
            <RowDefinition Height="*"/>
            <!-- Контент -->
        </Grid.RowDefinitions>

        <!-- ═══════════ ШАПКА-ТАББАР ═══════════ -->
        <Border Grid.Row="0" Background="#181825">
            <Grid Margin="10,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="⌨ CodeTypingTrainer"
                           Foreground="#CDD6F4" FontSize="15" FontWeight="Bold"
                           VerticalAlignment="Center" Margin="0,0,20,0"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="TabTrainingButton" Content="Тренировка"
                            Style="{StaticResource TabButtonStyle}"
                            Click="TabTraining_Click"/>
                    <Button x:Name="TabStatsButton" Content="Статистика"
                            Style="{StaticResource TabButtonStyle}"
                            Click="TabStats_Click"/>
                </StackPanel>

                <StackPanel Grid.Column="3" Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <TextBlock x:Name="ProfileNameText"
                               Foreground="#6C7086" FontSize="12"
                               VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <Button Content="☀" Width="30" Height="30" Margin="2,0"
                            Style="{StaticResource IconButtonStyle}"
                            Click="ThemeLight_Click"/>
                    <Button Content="🌙" Width="30" Height="30" Margin="2,0"
                            Style="{StaticResource IconButtonStyle}"
                            Click="ThemeDark_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══════════ ВКЛАДКА: ТРЕНИРОВКА ═══════════ -->
        <Grid x:Name="TrainingTab" Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SidePanelColumn" Width="170"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- БОКОВАЯ ПАНЕЛЬ -->
            <Border Grid.Column="0" Background="#181825">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Button Grid.Row="0" x:Name="CollapseButton"
                            Content="≡" HorizontalAlignment="Right"
                            Width="34" Height="34" Margin="4"
                            Style="{StaticResource IconButtonStyle}"
                            Click="CollapsePanel_Click"/>

                    <StackPanel x:Name="SidePanelContent" Grid.Row="1" Margin="8,0,8,8">

                        <TextBlock x:Name="SideModeLabel"
                                   Text="РЕЖИМ" Foreground="#6C7086"
                                   FontSize="10" Margin="4,4,4,6"/>
                        <Button Content="▶  Обычный режим"
                                Height="34" Margin="0,2"
                                Tag="Normal" Style="{StaticResource ModeButtonStyle}"
                                Click="ModeButton_Click"/>
                        <Button Content="🔊  На слух"
                                Height="34" Margin="0,2"
                                Tag="Audio" Style="{StaticResource ModeButtonStyle}"
                                Click="ModeButton_Click"/>

                        <TextBlock x:Name="SideLangLabel"
                                   Text="ЯЗЫК" Foreground="#6C7086"
                                   FontSize="10" Margin="4,14,4,6"/>
                        <ComboBox x:Name="LanguageCombo" Height="34"
                                Style="{StaticResource StyledComboBox}"
                                SelectionChanged="LanguageCombo_SelectionChanged">
                            <ComboBoxItem Content="Python" IsSelected="True"/>
                            <ComboBoxItem Content="JavaScript"/>
                            <ComboBoxItem Content="C++"/>
                            <ComboBoxItem Content="Java"/>
                            <ComboBoxItem Content="Go"/>
                        </ComboBox>

                        <StackPanel x:Name="AudioControlsPanel" Visibility="Collapsed">
                            <TextBlock Text="ОЗВУЧКА" Foreground="#6C7086"
                                       FontSize="10" Margin="4,14,4,6"/>
                            <Button x:Name="ReplayLineButton" Content="🔁  Повторить"
                                    Height="32" Margin="0,2"
                                    Style="{StaticResource ModeButtonStyle}"
                                    Click="ReplayLineButton_Click"/>
                            <Button x:Name="NextLineButton" Content="⏭  Следующая"
                                    Height="32" Margin="0,2"
                                    Style="{StaticResource ModeButtonStyle}"
                                    Click="NextLineButton_Click"/>
                            <TextBlock Text="Скорость" Foreground="#6C7086"
                                       FontSize="10" Margin="4,10,4,4"/>
                            <Slider x:Name="SpeedSlider"
                                    Minimum="0.5" Maximum="2" Value="1"
                                    TickFrequency="0.25" IsSnapToTickEnabled="True"
                                    ValueChanged="SpeedSlider_ValueChanged"/>
                            <Button x:Name="ShowCodeButton" Content="👁  Показать код"
                                    Height="32" Margin="0,8,0,2" IsEnabled="False"
                                    Style="{StaticResource ModeButtonStyle}"
                                    Click="ShowCodeButton_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- РАБОЧАЯ ЗОНА -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="1.4*"/>
                    <!-- Код чуть больше -->
                    <RowDefinition Height="0.8*"/>
                    <!-- Клавиатура ~20% меньше -->
                </Grid.RowDefinitions>

                <!-- КОД + ВВОД -->
                <Border Grid.Row="0" Background="#181825"
                        Margin="8,8,8,4" CornerRadius="8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="34"/>
                            <!-- Статистика -->
                            <RowDefinition Height="*"/>
                            <!-- Код+ввод -->
                            <RowDefinition Height="40"/>
                            <!-- Кнопки -->
                        </Grid.RowDefinitions>

                        <!-- Статистика сессии -->
                        <StackPanel Grid.Row="0" Orientation="Horizontal"
                                    VerticalAlignment="Center" Margin="12,0">
                            <Border Background="#313244" CornerRadius="4"
                                    Padding="10,3" Margin="0,0,6,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="WPM: " Foreground="#6C7086" FontSize="12"/>
                                    <TextBlock x:Name="WpmText" Text="0"
                                               Foreground="#A6E3A1" FontWeight="Bold" FontSize="12"/>
                                </StackPanel>
                            </Border>
                            <Border Background="#313244" CornerRadius="4"
                                    Padding="10,3" Margin="0,0,6,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Точность: " Foreground="#6C7086" FontSize="12"/>
                                    <TextBlock x:Name="AccuracyText" Text="100%"
                                               Foreground="#89B4FA" FontWeight="Bold" FontSize="12"/>
                                </StackPanel>
                            </Border>
                            <Border Background="#313244" CornerRadius="4" Padding="10,3">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Время: " Foreground="#6C7086" FontSize="12"/>
                                    <TextBlock x:Name="TimerText" Text="0:00"
                                               Foreground="#F9E2AF" FontWeight="Bold" FontSize="12"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Зона кода — InputBox поверх CodeDisplay -->
                        <Grid Grid.Row="1" Margin="12,4">
                            <ScrollViewer x:Name="CodeScroller"
                                          VerticalScrollBarVisibility="Auto"
                                          Background="#1E1E2E">
                                <TextBlock x:Name="CodeDisplay"
                                           FontFamily="Cascadia Code, Consolas, Courier New"
                                           FontSize="15" TextWrapping="Wrap"
                                           xml:space="preserve"
                                           Foreground="#CDD6F4" Padding="10"
                                           Text="Нажмите «Старт» для начала тренировки"/>
                            </ScrollViewer>

                            <!-- InputBox прозрачный поверх кода -->
                            <Grid>
                                <TextBox x:Name="InputBox"
                                         FontFamily="Cascadia Code, Consolas, Courier New"
                                         FontSize="15"
                                         Background="Transparent"
                                         Foreground="Transparent"
                                         CaretBrush="#CDD6F4"
                                         BorderThickness="0"
                                         Padding="10"
                                         AcceptsReturn="True" AcceptsTab="True"
                                         IsEnabled="False"
                                         TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Disabled"
                                         HorizontalScrollBarVisibility="Disabled"
                                         TextChanged="InputBox_TextChanged"
                                         PreviewKeyDown="InputBox_PreviewKeyDown"
                                         PreviewTextInput="InputBox_PreviewTextInput"/>
                                <Popup x:Name="SuggestionsPopup"
                                       PlacementTarget="{x:Reference InputBox}"
                                       Placement="Bottom" StaysOpen="False">
                                    <Border Background="#313244" BorderBrush="#585B70"
                                            BorderThickness="1" CornerRadius="4">
                                        <ListBox x:Name="SuggestionsList"
                                                 Background="Transparent" BorderThickness="0"
                                                 Foreground="#CDD6F4"
                                                 FontFamily="Cascadia Code, Consolas"
                                                 FontSize="13" MaxHeight="140"
                                                 MouseDoubleClick="SuggestionsList_MouseDoubleClick"
                                                 KeyDown="SuggestionsList_KeyDown">
                                            <ListBox.ItemContainerStyle>
                                                <Style TargetType="ListBoxItem">
                                                    <Setter Property="Padding" Value="8,4"/>
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="#45475A"/>
                                                        </Trigger>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter Property="Background" Value="#89B4FA"/>
                                                            <Setter Property="Foreground" Value="#1E1E2E"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ListBox.ItemContainerStyle>
                                        </ListBox>
                                    </Border>
                                </Popup>
                            </Grid>
                        </Grid>

                        <!-- Кнопки управления -->
                        <StackPanel Grid.Row="2" Orientation="Horizontal"
                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Button x:Name="StartButton" Content="▶  Старт"
                                    Width="100" Margin="4,0"
                                    Style="{StaticResource ActionButtonStyle}"
                                    Click="StartButton_Click"/>
                            <Button x:Name="PauseButton" Content="⏸  Пауза"
                                    Width="100" Margin="4,0" IsEnabled="False"
                                    Style="{StaticResource ActionButtonStyle}"
                                    Click="PauseButton_Click"/>
                            <Button x:Name="RestartButton" Content="↺  Заново"
                                    Width="100" Margin="4,0" IsEnabled="False"
                                    Style="{StaticResource ActionButtonStyle}"
                                    Click="RestartButton_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ЭКРАННАЯ КЛАВИАТУРА -->
                <Border Grid.Row="1" Background="#181825"
                        Margin="8,4,8,8" CornerRadius="8" Padding="10">
                    <Viewbox Stretch="Uniform">
                        <Canvas x:Name="OnScreenKeyboardCanvas" Width="900" Height="260"/>
                    </Viewbox>
                </Border>
            </Grid>
        </Grid>

        <!-- ═══════════ ВКЛАДКА: СТАТИСТИКА ═══════════ -->
        <Grid x:Name="StatsTab" Grid.Row="1" Visibility="Collapsed">
            <Grid Margin="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <!-- Фильтры -->
                    <RowDefinition Height="Auto"/>
                    <!-- Сводка -->
                    <RowDefinition Height="*"/>
                    <!-- График + тепловая карта -->
                </Grid.RowDefinitions>

                <!-- Фильтры -->
                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <Button x:Name="FilterAllButton" Content="Всё время"
                                Margin="0,0,6,0"
                                Style="{StaticResource FilterButtonStyle}"
                                Click="FilterAll_Click"/>
                        <Button x:Name="FilterWeekButton" Content="Неделя"
                                Margin="0,0,6,0"
                                Style="{StaticResource FilterButtonStyle}"
                                Click="FilterWeek_Click"/>
                        <Button x:Name="FilterTodayButton" Content="Сегодня"
                                Style="{StaticResource FilterButtonStyle}"
                                Click="FilterToday_Click"/>
                    </StackPanel>
                    <Button x:Name="ClearStatsButton" Content="🗑  Сбросить всё"
                            HorizontalAlignment="Right"
                            Style="{StaticResource FilterButtonStyle}"
                            Click="ClearStatsButton_Click"/>
                </Grid>

                <!-- Сводка -->
                <Border Grid.Row="1" Background="#181825" CornerRadius="8"
                        Padding="16,12" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="СЕССИЙ" Foreground="#6C7086" FontSize="10"/>
                            <TextBlock x:Name="TotalSessionsText" Text="0"
                                       Foreground="#CDD6F4" FontSize="26" FontWeight="Bold"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="ЛУЧШИЙ WPM" Foreground="#6C7086" FontSize="10"/>
                            <TextBlock x:Name="BestWpmText" Text="0"
                                       Foreground="#A6E3A1" FontSize="26" FontWeight="Bold"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="СР. ТОЧНОСТЬ" Foreground="#6C7086" FontSize="10"/>
                            <TextBlock x:Name="AvgAccuracyText" Text="0%"
                                       Foreground="#89B4FA" FontSize="26" FontWeight="Bold"/>
                        </StackPanel>
                        <StackPanel Grid.Column="3">
                            <TextBlock Text="СИМВОЛОВ" Foreground="#6C7086" FontSize="10"/>
                            <TextBlock x:Name="TotalKeystrokesText" Text="0"
                                       Foreground="#F9E2AF" FontSize="26" FontWeight="Bold"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- График + тепловая карта рядом -->
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <!-- График -->
                        <ColumnDefinition Width="16"/>
                        <!-- Отступ -->
                        <ColumnDefinition Width="*"/>
                        <!-- Тепловая карта -->
                    </Grid.ColumnDefinitions>

                    <!-- График -->
                    <Border Grid.Column="0" Background="#181825"
                            CornerRadius="8" Padding="16">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="Прогресс"
                                       Foreground="#CDD6F4" FontSize="13" FontWeight="Bold"
                                       Margin="0,0,0,8"/>
                            <Canvas Grid.Row="1" x:Name="ProgressChartCanvas"
                                    Background="#11111B"/>
                            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0">
                                <Border Background="#A6E3A1" Width="10" Height="10" Margin="0,0,5,0"/>
                                <TextBlock Text="WPM" Foreground="#A6E3A1" FontSize="11" Margin="0,0,14,0"/>
                                <Border Background="#89B4FA" Width="10" Height="10" Margin="0,0,5,0"/>
                                <TextBlock Text="Точность" Foreground="#89B4FA" FontSize="11"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Тепловая карта -->
                    <Border Grid.Column="2" Background="#181825"
                            CornerRadius="8" Padding="16">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="Тепловая карта ошибок"
                                       Foreground="#CDD6F4" FontSize="13" FontWeight="Bold"
                                       Margin="0,0,0,8"/>
                            <Viewbox Grid.Row="1" Stretch="Uniform">
                                <Canvas x:Name="KeyboardCanvas" Width="900" Height="260"/>
                            </Viewbox>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>